# ── Required ────────────────────────────────────────────────────────────────
# Token of a bot you create with @BotFather (/newbot). Use a bot no other program polls.
BOT_TOKEN=
# Your numeric Telegram user id (ask @userinfobot). The owner controls the bot (/admin).
OWNER_ID=

# ── Basics ──────────────────────────────────────────────────────────────────
# Where the SQLite database and temporary media live.
DATA_DIR=./data
# Default Grok model (change later with /model or /admin).
GROK_MODEL=grok-4.7
# Time zone for reminders, scheduled posts, usage days and times shown (IANA name).
TIMEZONE=Asia/Taipei
# Translation/card language for new groups and private chats: zh-tw, zh-cn, en, ja, ko or off.
DEFAULT_LANGUAGE=zh-tw

# ── Optional: reading links and videos ──────────────────────────────────────
# Tavily key (app.tavily.com) for clean page text; without it pages are fetched directly.
TAVILY_API_KEY=
# yt-dlp executable (deploy installs an auto-updated one at /opt/yt-dlp/bin/yt-dlp).
YTDLP_PATH=
# Proxy for video sites that block the server, e.g. socks5://127.0.0.1:1080 (Bilibili).
YTDLP_PROXY=
# ParseHub helper for Douyin/Weibo/Xiaohongshu/… (deploy sets http://127.0.0.1:8765).
PARSEHUB_URL=

# ── Optional: big files (local Bot API server, see deploy/use-local-bot-api.sh) ─
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_ROOT=
# Upload limit in MB (default 50, or 2000 with TELEGRAM_API_ROOT).
MAX_UPLOAD_MB=

# ── Optional: other ─────────────────────────────────────────────────────────
# Answer inline queries ("@bot <link>") from anyone, not just people with private access.
INLINE_PUBLIC=
# A second, alert-only bot used by the watchdog when the main bot can't send (deploy/grokbot-watchdog.sh).
ALERT_BOT_TOKEN=
